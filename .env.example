# Local development targets. Copy to .env.local and fill with your own credentials.
DATABASE_URL_DOCKER=postgresql://postgres:password@localhost:5432/anclora_talent
DATABASE_URL_DOCKER_UNPOOLED=postgresql://postgres:password@localhost:5432/anclora_talent
DATABASE_URL_NEON=postgresql://user:password@host.neon.tech/database?sslmode=require
DATABASE_URL_NEON_UNPOOLED=postgresql://user:password@host.neon.tech/database?sslmode=require

# Local-only URLs are set by scripts/local-dev.mjs.
# Keep the dedicated persistent QA account credentials in .env.local.
AUTH_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
